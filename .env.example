# TrustLance environment configuration (documentation §13)
# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# Generate the JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
API_PORT=4000

# ---- Data layer ----
# Host-facing URLs. Matches docker-compose.yml credentials.
DATABASE_URL=postgresql://trustlance:trustlance_dev_pw@localhost:5432/trustlance?schema=public
TEST_DATABASE_URL=postgresql://trustlance:trustlance_dev_pw@localhost:5432/trustlance_test?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth (§11: short-lived access tokens, rotating refresh tokens) ----
# These MUST be different values from each other.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_COST=12

# ---- Escrow & limits ----
# Days of client silence after submission before escrow auto-releases (§10.2).
AUTO_RELEASE_DAYS=7
# Auth stays tight (credential stuffing / sybil signups); general API traffic is
# generous because one page render legitimately makes several calls.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600

# ---- Reputation signing (Sprint 4, Day 16) ----
# Ed25519 keypair used to sign portable work records (§10.1).
# Not used until Sprint 4 — left blank in Sprint 1.
# The private key belongs in a secret store, never in the repo.
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
# Key identifier embedded as the JWS `kid` header, so keys can be rotated
# without invalidating every historical record. Reserved now, used in Sprint 4.
SIGNING_KEY_ID=trustlance-key-2026-01

# ---- OAuth (optional) ----
# Google sign-in. Leave BLANK to disable: the API then reports the provider as
# unconfigured and the web app hides the button entirely — the app runs fine
# without it.
#
# To enable (free):
#   1. console.cloud.google.com -> new project
#   2. APIs & Services -> OAuth consent screen -> External -> add your email as
#      a test user
#   3. Credentials -> Create credentials -> OAuth client ID -> Web application
#   4. Authorised redirect URI must match EXACTLY:
#      http://localhost:4000/api/auth/oauth/google/callback
#      (in production: https://YOUR-API-HOST/api/auth/oauth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of THIS API — used to build the OAuth redirect_uri.
API_PUBLIC_URL=http://localhost:4000

# ---- Web ----
CLIENT_ORIGIN=http://localhost:3000

# SameSite policy for the refresh cookie.
#   strict — API and web share a registrable domain (localhost, or
#            app.example.com + api.example.com). Correct for local dev.
#   none   — split hosts, e.g. a Vercel frontend calling a Railway API. They are
#            different SITES, so a Strict cookie is never sent and login silently
#            fails. Requires HTTPS; only valid when NODE_ENV=production.
COOKIE_SAMESITE=strict

# ---- Web (apps/web/.env.local) ----
# NEXT_PUBLIC_ prefixed vars are inlined into the browser bundle. Never put a
# secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
